# ============================================================================
# Nuhoud — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to GitHub!

# Prisma (SQLite for dev, PostgreSQL for Supabase production)
DATABASE_URL="file:./db/custom.db"

# JWT secret (change this to a long random string!)
NUHOUD_JWT_SECRET="nuhoud-dev-secret-change-in-prod-7f3a9e1b"

# Sync API key (shared between the Python pose-server and Next.js)
NUHOUD_SYNC_API_KEY="nuhoud-internal-sync-dev-7f3a9e1b"

# Supabase (uncomment for production)
# SUPABASE_URL="https://xxx.supabase.co"
# SUPABASE_ANON_KEY="xxx"
# DATABASE_URL="postgresql://xxx:xxx@db.xxx.supabase.co:5432/postgres"
