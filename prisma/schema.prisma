// NeuroMove Prisma schema
// Phase 2 data model: users (role-based), treatment_plans, rehab_sessions,
// exercise presets, achievements. SQLite provider for the sandbox MVP;
// the same schema runs on PostgreSQL/Supabase in production by flipping
// the provider + url.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A platform user - patient, clinician, or admin.
model User {
  id               String   @id @default(cuid())
  /// "PATIENT" | "DOCTOR" | "ADMIN" - String because SQLite has no enum.
  role             String   @default("PATIENT")
  email            String   @unique
  name             String
  /// bcrypt hash. Null for OAuth-only users (Phase 3).
  passwordHash     String?
  /// Avatar color seed (hex without #) for the deterministic gradient avatars.
  avatarSeed       String   @default("14b8a6")
  preferredDialect String   @default("omani")
  /// ISO date of birth, for clinical context.
  dateOfBirth      String?
  /// Affected side after stroke: "right" | "left" | "bilateral".
  affectedSide     String   @default("right")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Plans where this user is the patient.
  plans            TreatmentPlan[] @relation("PatientPlans")
  /// Plans where this user is the prescribing doctor.
  prescribedPlans  TreatmentPlan[] @relation("DoctorPlans")
  sessions         RehabSession[]
  earnedBadges     EarnedBadge[]

  @@index([role])
  @@index([email])
}

/// A clinician-prescribed rehabilitation plan for a patient.
model TreatmentPlan {
  id              String   @id @default(cuid())
  patientId       String
  patient         User     @relation("PatientPlans", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User     @relation("DoctorPlans", fields: [doctorId], references: [id])
  title           String   @default("Upper-limb rehab plan")
  /// "upper_right" | "upper_left" | "bilateral"
  targetLimb      String   @default("upper_right")
  targetAngle     Int      @default(90)
  sessionsPerWeek Int      @default(5)
  dailyRepGoal    Int      @default(20)
  startDate       DateTime @default(now())
  endDate         DateTime?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        RehabSession[]

  @@index([patientId])
  @@index([doctorId])
  @@index([active])
}

/// A completed rehabilitation session - one row per finished game/exercise.
model RehabSession {
  id                 String   @id @default(cuid())
  patientId          String
  patient            User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  planId             String?
  plan               TreatmentPlan? @relation(fields: [planId], references: [id])
  /// "live" = real webcam, "demo" = simulator
  source             String   @default("demo")
  limb               String   @default("right")
  sessionDate       DateTime @default(now())
  durationSeconds    Int      @default(0)
  totalReps          Int      @default(0)
  correctReps        Int      @default(0)
  maxAchievedAngle   Float    @default(0)
  compensationErrors Int      @default(0)
  gamificationScore  Int      @default(0)
  /// Per-frame angle samples (JSON array of floats) for session replay.
  angleTimeline      String?
  createdAt          DateTime @default(now())

  @@index([patientId])
  @@index([sessionDate])
  @@index([planId])
}

/// Library of clinical exercise presets the doctor can prescribe.
model ExercisePreset {
  id          String   @id @default(cuid())
  /// Stable slug used by the frontend, e.g. "elbow_flexion_90".
  slug        String   @unique
  name        String
  nameAr      String?
  description String
  /// "elbow" | "shoulder" | "wrist"
  joint       String   @default("elbow")
  limb        String   @default("right")
  targetAngle Int      @default(90)
  /// "beginner" | "intermediate" | "advanced"
  difficulty  String   @default("beginner")
  /// Suggested weekly sessions for this preset.
  sessionsPerWeek Int   @default(5)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// Gamification badges earned by a patient (one row per badge per patient).
model EarnedBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "first_session" | "ten_reps" | "perfect_form" | "streak_3" | ...
  slug      String
  earnedAt  DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

/// Persisted AI coach chat messages — one row per turn. Replaces the
/// in-memory conversation store so history survives server restarts.
/// A conversation is identified by (speakerId, patientId): the speaker
/// is whoever sent the message (patient themselves OR a doctor coaching
/// them), and patientId is whose clinical context was injected.
model ChatMessage {
  id          String   @id @default(cuid())
  /// Who sent this turn: the patient or the doctor.
  speakerId   String
  /// Whose clinical context the agent used (== speakerId for a patient
  /// coaching themselves; the coached patient for a doctor).
  patientId   String
  /// "user" = the human's message, "assistant" = the AI's reply.
  role        String
  content     String
  createdAt   DateTime @default(now())

  @@index([speakerId, patientId, createdAt])
  @@index([patientId])
}

/// Notification feed entries — badge earned, plan prescribed, streak
/// milestone, AI coach summary, etc. Shown in the header bell dropdown.
model Notification {
  id        String   @id @default(cuid())
  /// The user who should see this notification.
  userId    String
  /// "badge_earned" | "plan_prescribed" | "streak_milestone" |
  /// "session_saved" | "coach_summary" | "goal_achieved" | "info"
  type      String   @default("info")
  /// Short headline, e.g. "Badge earned: Perfect Form".
  title     String
  /// Longer body, e.g. "You completed a session with zero compensation errors."
  body      String?
  /// Severity for color-coding: "success" | "info" | "warning" | "celebration".
  severity  String   @default("info")
  /// Optional link target (e.g. a session id or patient id).
  linkType  String?
  linkId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId])
}

/// Doctor-set rehabilitation goals for a patient — specific ROM or rep-count
/// milestones to achieve by a target date. The patient sees a goal tracker
/// with progress; achieving a goal fires a celebration + notification.
model RehabGoal {
  id          String   @id @default(cuid())
  patientId   String
  /// "rom_target" (reach X degrees) | "rep_count" (complete X total reps) |
  /// "accuracy" (reach X% accuracy over N sessions) | "streak" (N-day streak)
  type        String   @default("rom_target")
  title       String
  /// The target value (degrees for rom_target, reps for rep_count, etc.).
  targetValue Float
  /// The current best-observed value (updated when sessions are saved).
  currentValue Float  @default(0)
  /// Whether the goal has been achieved.
  achieved    Boolean  @default(false)
  achievedAt  DateTime?
  startDate   DateTime @default(now())
  targetDate  DateTime?
  createdAt   DateTime @default(now())

  @@index([patientId, achieved])
  @@index([patientId])
}

/// Rehabilitation streak tracker — one row per patient. Counts consecutive
/// days with at least one session. Includes a "freeze" counter (grace days
/// that preserve a streak when the patient misses a day).
model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  /// Number of streak-freeze grace days available (max 2).
  freezesLeft   Int      @default(2)
  lastSessionDate String?
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
